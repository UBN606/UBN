# Google Drive (service account or OAuth)
# Either point at a service account JSON, or set GOOGLE_OAUTH_* vars.
GOOGLE_APPLICATION_CREDENTIALS=

# Higgsfield (Step 1, stills). Both must be set, or Step 1 falls back to
# writing manual prompts. Credentials come as a pair from the Higgsfield
# console; the SDK wants them combined as KEY_ID:KEY_SECRET internally.
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
# Optional. Override the model path passed to client.subscribe(...). Defaults
# to nano-banana-pro/text-to-image.
HIGGSFIELD_MODEL_PATH=

# LongCat-Video (Step 2, i2v). Path to a local clone of
# https://github.com/meituan-longcat/LongCat-Video and its weights.
LONGCAT_DIR=
LONGCAT_CHECKPOINT_DIR=

# Project layout in Drive
DRIVE_PROJECT_ROOT=1Gu3CLlc3hY4ovUABsNABU0oP1Ge1U-RO
DRIVE_VO_CLEAN=1VVbpLYzmTl-M_Uw3t2NEBpLpgY_Kr9NF
DRIVE_VO_ORIG=1Mcdsa74uc7E_Fp_s8FYj5UWyjI_NvUUH
DRIVE_AUDIO=1hAG2j9jbZBO60RnmIL37kXS6KtkRDCH3

# Local working dir for downloads, generation, upscale outputs
WORK_DIR=./outputs
