# Higgsfield API (Step 1, stills). Leave blank to fall back to manual prompt export.
HIGGSFIELD_API_KEY=
HIGGSFIELD_MODEL=nano-banana-pro

# LongCat-Video (Step 2, i2v). Path to a local clone of
# https://github.com/meituan-longcat/LongCat-Video and its weights.
LONGCAT_DIR=
LONGCAT_CHECKPOINT_DIR=

# Project layout in Drive
DRIVE_PROJECT_ROOT=1Gu3CLlc3hY4ovUABsNABU0oP1Ge1U-RO
